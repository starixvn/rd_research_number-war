  "name": "number-war",
  "version": "1.0",
  "description": "Calculate Odds for number war game",
  "license": "UNLICENSED",
  "type": "commonjs",
  "types": "dist/index.d.ts",
  "main": "dist/index.js",
  "files": [
    "dist/"
  ],
  "scripts": {
    "test-coverage": "jest",
    "build": "tsc",
    "reg": "npm set registry http://npm.lumigame.com",
